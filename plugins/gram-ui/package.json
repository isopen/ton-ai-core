{
  "name": "@ton-ai/gram-ui",
  "version": "0.1.0",
  "description": "Gram UI components for browser-based Telegram clients using MTProto",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/framework/jsx-runtime.d.ts",
      "default": "./dist/framework/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/framework/jsx-runtime.d.ts",
      "default": "./dist/framework/jsx-runtime.js"
    },
    "./framework/hooks": {
      "types": "./dist/framework/hooks.d.ts",
      "default": "./dist/framework/hooks.js"
    }
  },
  "author": "TON AI Core Team",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/inline-css.mjs && tsc && cp src/styles.css dist/styles.css",
    "watch": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ton-ai/atom": "*",
    "@ton-ai/core": "*",
    "@ton-ai/gram-debug": "*",
    "@ton-ai/tgs": "*",
    "@ton-ai/tmd": "*"
  },
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/qrcode": "^1.5.6",
    "typescript": "^5.3.3"
  }
}
