{
  "name": "ton-ai-core",
  "version": "0.2.0",
  "description": "TON AI Core",
  "private": true,
  "workspaces": [
    "packages/*",
    "plugins/*",
    "agents/*"
  ],
  "scripts": {
    "build": "npm run build -w @ton-ai/core && npm run build -ws --if-present",
    "build:core": "npm run build -w @ton-ai/core",
    "clean": "npm run clean -ws --if-present",
    "test": "npx jest",
    "test:mtproto": "npx jest plugins/mtproto/tests/",
    "test:crypton": "npx jest packages/core/src/crypton/tests/",
    "test:tl-language": "npx jest plugins/tl-language/tests/",
    "test:agent-transport": "npx jest plugins/agent-transport/tests/",
    "test:all": "npx jest",
    "version:core": "node scripts/set-version.mjs core",
    "version:plugins": "node scripts/set-version.mjs plugins",
    "version:plugin": "node scripts/set-version.mjs plugin",
    "version:agents": "node scripts/set-version.mjs agents",
    "version:agent": "node scripts/set-version.mjs agent",
    "version:all": "node scripts/set-version.mjs all"
  },
  "keywords": [
    "ton",
    "ai",
    "blockchain"
  ],
  "author": "testertesterov",
  "license": "MIT",
  "devDependencies": {
    "@jest/globals": "^27.5.1",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
