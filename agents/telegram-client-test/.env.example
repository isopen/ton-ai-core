# Required: Telegram API credentials (get from https://my.telegram.org/apps)
API_ID=12345
API_HASH=abcdef1234567890abcdef1234567890

# Optional: DC ID (default: 2)
DC_ID=2

# Optional: Proxy (default: socks5://127.0.0.1:7897)
# Koala Clash: socks5://127.0.0.1:7897
PROXY=socks5://127.0.0.1:7897

# Optional: Set to true to skip MTProto obfuscation
# Use with PROXY when proxy handles obfuscation (e.g. Koala Clash)
NO_OBFUSCATION=false

# Optional: Path to save/load auth key
AUTH_KEY_FILE=./auth_key.json

# --- Auth (ACTION=full) ---
# Phone number for authorization
PHONE_NUMBER=+79001234567
# Code received via Telegram (set after first run sends code)
PHONE_CODE=
# Action: handshake (default) or full (auth + messages)
ACTION=handshake

# --- Messaging (ACTION=full) ---
# Target user ID to send test message
TARGET_USER_ID=
# Target user access hash
TARGET_ACCESS_HASH=
