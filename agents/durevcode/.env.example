# durevcode example config — copy to .env and fill in (never commit .env)
TELEGRAM_BOT_API_TOKEN=TELEGRAM_BOT_API_TOKEN
DUREVCODE_CHAT_ID=DUREVCODE_CHAT_ID
DUREVCODE_DIR=DUREVCODE_DIR
DUREVCODE_LEAD_MENTION=0

#DUREVCODE_DB_PATH=~/.local/share/opencode/opencode.db
