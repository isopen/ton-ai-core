# durevcode example config — copy to .env and fill in (never commit .env)
TELEGRAM_BOT_API_TOKEN=TELEGRAM_BOT_API_TOKEN
DUREVCODE_CHAT_ID=DUREVCODE_CHAT_ID
DUREVCODE_DIR=DUREVCODE_DIR

#DUREVCODE_DB_PATH=~/.local/share/opencode/opencode.db
#OPENCODE_SERVER_URL=http://127.0.0.1:4096
#OPENCODE_AUTO_SERVE=1
#OPENCODE_BIN=opencode
#OPENCODE_SERVER_USERNAME=opencode
#OPENCODE_SERVER_PASSWORD=change-me
#OPENCODE_CLI_FALLBACK=1
#DUREVCODE_ALLOWED_USERS=123456789,987654321
#DUREVCODE_SESSION_ID=ses_f4cc46126ffeS3cqC3ZXZPHWXz
#DUREVCODE_SESSION_IDS=ses_aaa111,ses_bbb222
#DUREVCODE_MAX_SESSIONS=5
#DUREVCODE_USE_THREADS=1
#DUREVCODE_TYPING=1
#DUREVCODE_REASONING_STREAM=1
#DUREVCODE_REASONING_REPAINT=1
#DUREVCODE_LEAD_MENTION=1
#DUREVCODE_QUOTE_REPLIES=1
#DUREVCODE_ANSWER_FANOUT=1
#DUREVCODE_NEW_TOPICS=1
#DUREVCODE_WATCH_ONLY=1
#DUREVCODE_STATE_PATH=~/.local/share/durevcode/state.json
#DUREVCODE_POLL_MS=2000
#DUREVCODE_IDLE_SEC=90
#DUREVCODE_AUTO_CONTINUE_SEC=60
#DUREVCODE_AUTO_CONTINUE_MAX=10
#DUREVCODE_AUTO_FINISH=1
#DUREVCODE_DELETE_ON_TOPIC_GONE=0

# Whisper voice transcription (whisper.cpp; bin + GGML model is on you)
#DUREVCODE_WHISPER_ENABLED=0
#DUREVCODE_WHISPER_BIN=whisper-cli
#DUREVCODE_WHISPER_MODEL=~/.local/share/durevcode/whisper/ggml-base.bin
#DUREVCODE_WHISPER_FFMPEG=ffmpeg
#DUREVCODE_WHISPER_LANGUAGE=auto
#DUREVCODE_WHISPER_THREADS=4
#DUREVCODE_WHISPER_GPU=0
#DUREVCODE_WHISPER_SERVER_URL=http://127.0.0.1:8178
#DUREVCODE_WHISPER_AUTO_SERVE=1
#DUREVCODE_WHISPER_SERVER_BIN=/home/user/proj/whisper.cpp/build/bin/whisper-server
